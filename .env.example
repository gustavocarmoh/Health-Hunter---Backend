# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-min-32-chars

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000
# Produção: https://app.healthhunter.com

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=health_hunter
DB_SSL=false
# DB_RETRY_ATTEMPTS=10
# DB_RETRY_DELAY_MS=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_RETRY_ATTEMPTS=10

# IA Mentor (Google Gemini — tier gratuito via Google AI Studio)
# Gere sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

  "_deprecated": "Este arquivo não é mais usado. A infraestrutura foi migrada de ECS Fargate para EC2 t2.micro (free tier). O deploy agora usa Docker Compose no EC2 via SSM Run Command. Consulte .aws/ec2-infra.yml e .github/workflows/deploy.yml.",
  "_novo_template": ".aws/ec2-infra.yml",
  "_compose_file": "gerado em /app/docker-compose.prod.yml pelo UserData do CloudFormation"
}


  "cpu": "256",
  "memory": "512",

  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/health-hunter-bff-task-role",

  "containerDefinitions": [
    {
      "name": "health-hunter-bff",
      "image": "ACCOUNT_ID.dkr.ecr.AWS_REGION.amazonaws.com/health-hunter-bff:latest",

      "essential": true,

      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],

      "environment": [
        { "name": "NODE_ENV",  "value": "production" },
        { "name": "PORT",      "value": "3000" },
        { "name": "DB_PORT",   "value": "5432" },
        { "name": "DB_SSL",    "value": "true" },
        { "name": "REDIS_PORT","value": "6379" }
      ],

      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:DB_HOST::"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:DB_USERNAME::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:DB_PASSWORD::"
        },
        {
          "name": "DB_DATABASE",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:DB_DATABASE::"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:REDIS_HOST::"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:REDIS_PASSWORD::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:JWT_SECRET::"
        },
        {
          "name": "JWT_REFRESH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:JWT_REFRESH_SECRET::"
        },
        {
          "name": "ALLOWED_ORIGINS",
          "valueFrom": "arn:aws:secretsmanager:AWS_REGION:ACCOUNT_ID:secret:health-hunter/prod:ALLOWED_ORIGINS::"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/health-hunter-bff",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },

      "readonlyRootFilesystem": false,
      "privileged": false,

      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
